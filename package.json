{
  "name": "chattersphere",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "build": "npm run build --prefix frontend",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "test:server": "node scripts/test-server.js",
    "format": "prettier --write backend frontend/src tests scripts *.js *.json .github/workflows/ci.yml render.yaml"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "mongodb-memory-server": "^10.2.1",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4"
  }
}
